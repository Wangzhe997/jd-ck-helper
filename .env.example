# 青龙面板地址（青龙跑在 R2S 本机 5700 端口就保持默认）
QL_URL=http://127.0.0.1:5700

# 青龙『系统设置 → 应用设置 → 新建应用』得到，务必填写
QL_CLIENT_ID=
QL_CLIENT_SECRET=

# 京东 CK 变量名，一般不用改
ENV_NAME=JD_COOKIE

# multi=一账号一个变量（推荐，备注显示昵称，谁掉了一眼看到）
# merge=所有账号合并进一个变量换行分隔（兼容老脚本）
MODE=multi

# 监听端口与地址
PORT=8787
BIND_HOST=0.0.0.0

# ── 登录保护 ──────────────────────────────────────────────────────────
# 推荐做法：容器起来后，在页面右上角「🔒 设置登录保护」里直接设用户名和密码。
# 凭据保存在 ./data/auth.json（已挂载为卷，重建容器不丢），之后可随时在页面修改。
#
# 下面两项是可选的「首次启动初始凭据」：填了 ACCESS_PASSWORD，第一次启动会
# 自动用该用户名/密码创建登录保护；之后请以页面保存的为准（页面优先级更高，
# 不会被这里覆盖回去）。留空 = 暂不启用登录保护（仅限纯内网）。
ACCESS_USERNAME=admin
ACCESS_PASSWORD=

TZ=Asia/Shanghai
